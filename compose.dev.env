# Local host-port allocation. Keep this file committed so the local projects
# (vernissage, keepsake, atelierlabs) can run together without port clashes.
#
# WEB_PORT: 사이트 서버(app/main.py). 지금 실제로 쓰는 포트는 이것뿐이다.
# API_PORT / POSTGRES_PORT / REDIS_PORT: atelierlabs에 배정된 예약 포트.
#   아직 해당 서비스가 없다. docker-compose.yml에 추가할 때 이 값을 쓴다.
WEB_PORT=13000
# Vernissage API 프로젝트의 로컬 Docker 포트. 사이트 서버 컨테이너에서 호스트의
# 18000 포트로 접근한다. 브라우저는 항상 같은 오리진의 /api/vernissage/... 를 호출한다.
VERNISSAGE_API_BASE_URL=http://host.docker.internal:18000
# Keepsake API 프로젝트의 로컬 개발 포트. 법률 문서만 서버가 같은 origin으로 프록시한다.
KEEPSAKE_API_BASE_URL=http://host.docker.internal:18020
API_PORT=18010
POSTGRES_PORT=15433
REDIS_PORT=16380
