# Local host-port allocation. Keep this file committed so the local projects
# (vernissage, keepsake, atelierlabs) can run together without port clashes.
#
# WEB_PORT: 사이트 서버(app/main.py). 지금 실제로 쓰는 포트는 이것뿐이다.
# API_PORT / POSTGRES_PORT / REDIS_PORT: atelierlabs에 배정된 예약 포트.
#   아직 해당 서비스가 없다. docker-compose.yml에 추가할 때 이 값을 쓴다.
WEB_PORT=13000
API_PORT=18010
POSTGRES_PORT=15433
REDIS_PORT=16380
